# Device mapper targets required before Android mounts its partitions.
CONFIG_TRUSTED_KEYS=y
CONFIG_ENCRYPTED_KEYS=y
CONFIG_CRYPTO_ESSIV=y
CONFIG_DM_CRYPT=y

# Android init expects these nodes to be created when binderfs is mounted.
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# Live boot loads modules and firmware from separate filesystems.
# LoadPin would reject every source after the first one with EPERM.
# CONFIG_SECURITY_LOADPIN is not set
